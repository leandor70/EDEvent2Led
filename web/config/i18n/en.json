    "req_ed_desc": "Journal files enabled (default)",
    "req_python": "Python 3.11+",
    "req_python_desc": "Runtime environment",
    "req_hardware": "RGB Hardware",
    "req_hardware_desc": "Keyboard, mouse, case lighting, etc. (supported by OpenRGB)",
    "quick_start_title": "Quick Start",
    "quick_start_step1_title": "Configuration",
    "quick_start_step1_desc": "Connect to OpenRGB, set the Elite Dangerous journal path, and choose your language.",
    "quick_start_step2_title": "Device Management",
    "quick_start_step2_desc": "Enable the RGB devices you want to control and configure their behavior.",
    "quick_start_step3_title": "Effects Editor",
    "quick_start_step3_desc": "Create multi-step lighting sequences: choose colors, durations, and transition types.",
    "quick_start_step4_title": "Event Mapping",
    "quick_start_step4_desc": "Assign each effect to one or more Elite Dangerous events and set priority levels.",
    "quick_start_step5_title": "Start Monitoring",
    "quick_start_step5_desc": "Press the Start button on this page. ED:Event2Led will process journal events in real-time.",
    "privacy_title": "Data & Privacy",
    "privacy_p1": "ED:Event2Led operates entirely locally. It reads Elite Dangerous journal files on your machine and communicates with OpenRGB over localhost only. No data is collected, transmitted, or stored externally. Configuration is saved in local JSON files in the config/ directory.",
