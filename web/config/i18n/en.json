  "about": {
    "title": "About ED:Event2Led",
    "intro_p1": "ED:Event2Led is a real-time RGB lighting control application for Elite Dangerous. It monitors the game's journal files and synchronizes your RGB hardware (keyboard, mouse, case lighting, etc.) with in-game events using OpenRGB.",
    "intro_p2": "From hyperspace jumps to docking procedures, combat alerts to fuel warnings, every Elite Dangerous event can trigger a custom lighting effect, creating an immersive ambient experience that extends beyond the screen.",
    "requirements_title": "System Requirements",
    "req_windows": "Windows 10/11 (64-bit)",
    "req_openrgb": "OpenRGB",
    "req_openrgb_desc": "RGB control server (open-source, available at openrgb.org)",
