# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.obsidian/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
nul

# ── Temporary / build artifacts ───────────────────────────────────────────────
# NB: i commenti inline NON sono supportati in .gitignore — vanno su righe proprie.
*.tmp
*.bak
*~
# Generated Tailwind CSS — rebuild with: cd web && npm run build
web/dist/
# Generated by build script — not tracked in repo
INSTALLATION_PACKAGE/
# Build output directory
dist/
dist_tmp/
# Release archives + relativi checksum (distribuiti via GitHub Releases, mai in git)
*.zip
*.zip.sha256

# ── Logs & runtime output ─────────────────────────────────────────────────────
log/
*.log
events_api_output.txt
network-requests.txt

# ── Test / dev artifacts ──────────────────────────────────────────────────────
.pytest_cache/
.playwright-mcp/
testimages/

# ── User configuration (machine-specific, not shared) ────────────────────────
config/settings.json
config/keyboard_presets.json
# Note: visual_effects.json, event_mappings.json, color_schemes.json
#       ARE committed as starter defaults (not machine-specific)

# ── Claude Code project metadata (not relevant to contributors) ───────────────
.claude/
.interface-design/

# ── Node.js ───────────────────────────────────────────────────────────────────
web/node_modules/
web/package-lock.json
node_modules/

# ── Staging area (delete when stable) ────────────────────────────────────────
da_cancellare/

# ── Session notes (machine-specific, not shared) ─────────────────────────────
BLOOM_EXPANSION_FACTOR_DEBUG.md
QUICK_RESUME*.md
SESSION_RESUME*.md
TODO_NEXT_SESSION.md
TOUR_SYSTEM_TEST_RESULTS.md
TOUR_TEST_INDEX.md
TOUR_TRANSPARENCY_ANALYSIS.md
KEYBOARD_RESIDUAL_COLOR_FIX.md
test-tour.js
test_navigation.html

# ── Build output ──────────────────────────────────────────────────────────────
build/icon.ico
# PyInstaller intermediate build artifacts
build/EDEvent2Led/
